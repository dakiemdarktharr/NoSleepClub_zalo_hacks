# NORA local LLM configuration. Copy to .env.local and fill the empty values.
# .env.local is ignored by Git. Do not paste secrets into issues or chat.
# This endpoint must implement the selected API style; it is not a web chat URL.
NORA_LLM_API_STYLE=openai-responses
NORA_LLM_BASE_URL=https://api.openai.com/v1
NORA_LLM_API_KEY=
NORA_LLM_MODEL=gpt-6-luna
NORA_LLM_REASONING_EFFORT=xhigh

# Limits are enforced by the application, not sent as system instructions.
NORA_LLM_TIMEOUT_SECONDS=60
NORA_LLM_MAX_OUTPUT_TOKENS=2048
NORA_LLM_MAX_CALLS_PER_GOAL=24
# Web-search usage and conservative context reservations share this budget.
# 48000 can stop a research-to-note flow before its final reply; tune for cost.
NORA_LLM_MAX_INPUT_TOKENS_PER_GOAL=96000
NORA_LLM_MAX_OUTPUT_TOKENS_PER_GOAL=12000
